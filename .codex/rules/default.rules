# Read-only repository inspection and the project's normal verification commands may run directly.
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "Read-only Git inspection is part of normal project work.",
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging changes is allowed; committing and pushing are separate prompted operations.",
)

prefix_rule(
    pattern = [["rg", "sed", "wc", "ls", "pwd"]],
    decision = "allow",
    justification = "These commands are used for local read-only inspection.",
)

prefix_rule(
    pattern = ["node", ["--check", "--test"]],
    decision = "allow",
    justification = "Syntax checks and the repository's Node test suite are approved verification steps.",
)

prefix_rule(
    pattern = ["npm", "run", ["lint", "build", "test", "typecheck", "check", "synth", "test:render", "test:rewrite"]],
    decision = "allow",
    justification = "These are approved local verification scripts.",
)

prefix_rule(
    pattern = ["yarn", ["lint", "build", "test"]],
    decision = "allow",
    justification = "These are approved local verification scripts.",
)

prefix_rule(
    pattern = ["mint", ["validate", "broken-links"]],
    decision = "allow",
    justification = "These are approved local documentation checks.",
)

# Repository history, working-tree restoration, dependency changes, deletion, and external writes require explicit approval.
prefix_rule(
    pattern = ["git", ["commit", "push", "restore", "checkout", "switch", "merge", "rebase", "stash", "reset", "clean", "branch", "worktree", "tag", "pull", "fetch"]],
    decision = "prompt",
    justification = "This operation changes repository state or communicates with a remote and requires current-turn approval.",
)

prefix_rule(
    pattern = [["rm", "rmdir"]],
    decision = "prompt",
    justification = "Deletion requires current-turn approval.",
)

prefix_rule(
    pattern = ["npm", ["install", "i", "uninstall", "remove", "update"]],
    decision = "prompt",
    justification = "Dependency changes require current-turn approval.",
)

prefix_rule(
    pattern = ["yarn", ["install", "add", "remove", "upgrade"]],
    decision = "prompt",
    justification = "Dependency changes require current-turn approval.",
)

prefix_rule(
    pattern = ["pnpm", ["install", "add", "remove", "update"]],
    decision = "prompt",
    justification = "Dependency changes require current-turn approval.",
)

prefix_rule(
    pattern = ["npx"],
    decision = "prompt",
    justification = "npx may download and execute packages, so it requires current-turn approval.",
)

prefix_rule(
    pattern = [["aws", "sls", "serverless", "supabase"]],
    decision = "prompt",
    justification = "Cloud and database CLI operations may affect production and require current-turn approval.",
)

prefix_rule(
    pattern = [["cdk", "npm", "yarn"], ["deploy", "destroy"]],
    decision = "prompt",
    justification = "Deployment and destruction require current-turn approval.",
)

prefix_rule(
    pattern = ["npm", "run", ["deploy", "destroy"]],
    decision = "prompt",
    justification = "Deployment and destruction require current-turn approval.",
)

prefix_rule(
    pattern = ["yarn", ["deploy", "destroy"]],
    decision = "prompt",
    justification = "Deployment and destruction require current-turn approval.",
)
